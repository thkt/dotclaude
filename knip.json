{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "workflows/*.js",
    ".ja/workflows/*.js",
    "workflows/_lib/gate.ts",
    ".ja/workflows/_lib/gate.ts",
    "workflows/build/record.ts",
    "workflows/build/pr-body.ts",
    "workflows/assert/record.ts",
    "workflows/assert/worktree.ts",
    "workflows/assert/bootstrap.ts",
    "workflows/audit/snapshot.ts",
    ".ja/workflows/audit/snapshot.ts",
    "workflows/build/revalidate.ts",
    "workflows/build/verify-tests.ts",
    "workflows/build/diff-files.ts",
    "workflows/build/verify-pr.ts",
    "workflows/code/verify-commit.ts",
    ".ja/workflows/code/verify-commit.ts",
    ".ja/workflows/build/record.ts",
    ".ja/workflows/build/pr-body.ts",
    ".ja/workflows/assert/record.ts",
    ".ja/workflows/assert/worktree.ts",
    ".ja/workflows/assert/bootstrap.ts",
    ".ja/workflows/build/revalidate.ts",
    ".ja/workflows/build/verify-tests.ts",
    ".ja/workflows/build/diff-files.ts",
    ".ja/workflows/build/verify-pr.ts",
    "workflows/**/*.test.{js,ts}",
    "workflows/tests/index.js",
    "hooks/**/tests/*.test.ts",
    "hooks/_lib/hook_payload.ts",
    "hooks/_lib/mirror_prose.ts",
    "hooks/lifecycle/recall_index.ts",
    "hooks/edit/rust_pre_edit.ts",
    "hooks/edit/rust_post_edit.ts",
    "hooks/edit/textlint_fix.ts",
    "hooks/edit/rumdl_check.ts",
    "hooks/_lib/command_scan.ts",
    "hooks/security/git_sandbox_guard.ts",
    "hooks/security/npm_install_guard.ts",
    "hooks/security/rm_to_trash.ts",
    "hooks/pre-bash/client_identifier_gate.ts",
    "hooks/pre-bash/package_manager_rewrite.ts",
    "hooks/pre-bash/body_proofread.ts",
    "hooks/edit/mirror_prose_guard.ts",
    "skills/**/tests/**/*.test.{js,ts}",
    "skills/_lib/harness_hash.ts",
    ".ja/skills/_lib/harness_hash.ts",
    "skills/_lib/review_score.ts",
    ".ja/skills/_lib/review_score.ts",
    "skills/**/scripts/*.{js,mjs,ts}",
    ".ja/skills/**/scripts/*.{js,mjs,ts}",
    "tests/*.test.{js,ts}",
    "agents/**/tests/*.test.{js,ts}"
  ],
  "project": [
    "workflows/**/*.{js,ts}",
    ".ja/workflows/**/*.{js,ts}",
    "hooks/**/*.ts",
    "skills/**/*.{js,mjs,ts}",
    ".ja/skills/**/*.{js,mjs,ts}",
    "tests/**/*.{js,ts}",
    "agents/**/*.{js,ts}"
  ],
  "ignoreBinaries": ["codex", "markdownlint-cli2", "rumdl"],
  "ignoreDependencies": ["oxfmt", "^@?textlint"],
  "ignoreFiles": [
    "workflows/tests/fixtures/**",
    "hooks/**/tests/fixtures/**",
    "tests/fixtures/**",
    "agents/**/tests/fixtures/**",
    "skills/*/test/cases/**"
  ]
}
