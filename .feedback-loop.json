{
  "runner": "bun",
  "testGlobs": [
    "tests/**/*.test.ts",
    "tests/**/*.test.js",
    "agents/**/*.test.ts",
    "agents/**/*.test.js",
    "hooks/**/*.test.ts",
    "hooks/**/*.test.js",
    "skills/**/*.test.ts",
    "skills/**/*.test.js"
  ],
  "testArgs": ["--timeout", "300000"],
  "mutation": false,
  "assurance": [
    {"path": "hooks/_lib/tests/bun-runtime.test.ts", "reason": "唯一のテストが、darwin の host に /opt/homebrew/bin/bun があることを確かめる。repo のコードの振る舞いではなく、実行環境の前提を確かめる"},
    {"path": "hooks/_lib/tests/hooks-toolchain.test.ts", "reason": "2 つのテストが、package.json の test script が ./hooks を含むことと、tsc と oxlint のファイル一覧が git ls-files の hooks/*.ts をすべて含むことを確かめる。repo 全体の道具の設定の整合を確かめる"},
    {"path": "hooks/_lib/tests/shebang-ts.test.ts", "reason": "4 つのテストが、git ls-files -s で hooks/ の追跡ファイル全体を走査し、shebang と実行権限の整合を確かめる。hooks/_lib/tests/fixtures/shebang/ の fixture は shebang-scope.test.ts と共有するが、このファイルでは走査が空振りしないことを示す対照として使うだけで、混在ではない"},
    {"path": "skills/_lib/tests/script-modes.test.ts", "reason": "唯一のテストが、skills/*/scripts/*.ts と .ja の写しの git の mode と、CLI の shebang を走査する。repo 全体のファイルの mode の整合を確かめ、script の振る舞いは実行しない"},
    {"path": "tests/doc-test-names.test.ts", "reason": "README.md と docs/ 直下の Markdown が名前を挙げるテストファイルを、追跡ファイル全体の名前と照合する。文書と tree の整合を確かめる。抽出器のテストは走査が空振りしないことを示す対照である"},
    {"path": "tests/git-repo-scan.test.ts", "reason": "唯一のテストが、追跡ファイル全体を読み、withTempRepo を使わずに git init する .test.ts を探す。repo 全体の決まりの整合を確かめる"},
    {"path": "tests/ja-ts-parity.test.js", "reason": "中心のテストが、git ls-files の .ja/**/*.ts を英語の側と照合する。ほかの 7 つは比較器が空振りしないことを fixture で示す対照で、混在ではない"},
    {"path": "tests/lint-gate-wiring.test.js", "reason": "biome と oxlint を repo の root から全体にかけて exit 0 を確かめるテストと、.gitignore が追跡中の .js と .ts を Biome から隠さないことを確かめるテストからなる。repo 全体の整合を確かめる"},
    {"path": "tests/lint-suppression-absence.test.js", "reason": "中心のテストが、追跡ファイル全体から lint の抑止の書き方を探す。ほかの 3 つは走査が空振りしないことを示す対照である"},
    {"path": "tests/live-instructions.test.ts", "reason": "6 つのテストが、skills、agents、rules と .ja の写しの追跡ファイル全体を、home を起点にしたパスや固定したモデルなどの決まりの違反について走査する。repo 全体の整合を確かめる"},
    {"path": "tests/phase-handoff.test.ts", "reason": "唯一のテストが、.ja/skills/*/SKILL.md 全体の Phase の参照に受け手があるかを走査する。skill 全体の整合を確かめ、1 つの skill の振る舞いは確かめない"},
    {"path": "tests/prose-language.test.ts", "reason": "中心のテストが、.ja の外の *.test.{js,ts} 全体のテスト名が日本語でないことを走査する。名前の抽出のテストは対照である"},
    {"path": "tests/python-invocation-sweep.test.ts", "reason": "唯一のテストが、plugins/ の外の追跡ファイル全体から python3 の呼び出しを探す。repo 全体の整合を確かめる"},
    {"path": "tests/skill-h1.test.ts", "reason": "2 つのテストが、skills/*/SKILL.md と .ja の写し全体の H1 の決まりを走査する。skill 全体の整合を確かめる"},
    {"path": "tests/table-paragraph.test.ts", "reason": "中心のテストが、agents、rules、skills、docs と .ja の写しの Markdown 全体から、表の後ろの段落を探す。ほかのテストは走査の届く範囲と分類器を確かめる対照である"}
  ],
  "ignoredChanges": ["**/*.md", ".ja/**", "docs/**"],
  "dependencies": [
    {"inputs": ["**/*.md", ".ja/**"], "tests": ["hooks/_lib/tests/mirror-prose.test.ts"]},
    {"inputs": ["skills/_lib/publish.md", ".ja/skills/_lib/publish.md", "skills/sweep/SKILL.md", ".ja/skills/sweep/SKILL.md", "skills/dr/SKILL.md", ".ja/skills/dr/SKILL.md", "skills/outcome/SKILL.md", ".ja/skills/outcome/SKILL.md", "rules/core/PREFLIGHT.md", ".ja/rules/core/PREFLIGHT.md", "skills/implement/scripts/launch.ts"], "tests": ["skills/_lib/tests/publish-contract.test.ts"]},
    {"inputs": ["skills/dr/SKILL.md", ".ja/skills/dr/SKILL.md", "skills/dr/templates/madr-template.md", ".ja/skills/dr/templates/madr-template.md", "skills/dr/references/madr-format.md", ".ja/skills/dr/references/madr-format.md", "agents/critics/critic-design.md"], "tests": ["skills/dr/tests/script-contract.test.js"]},
    {"inputs": ["skills/dr/SKILL.md", ".ja/skills/dr/SKILL.md", "skills/dr/templates/madr-template.md", ".ja/skills/dr/templates/madr-template.md"], "tests": ["skills/dr/tests/verification-lines.test.ts"]},
    {"inputs": ["skills/dr/tests/fixtures/pre-check-cases.json"], "tests": ["skills/dr/tests/pre-check.test.ts"]},
    {"inputs": ["skills/dr/tests/fixtures/update-index-cases.json"], "tests": ["skills/dr/tests/update-index.test.ts"]},
    {"inputs": ["skills/dr/tests/fixtures/validate-dr-cases.json"], "tests": ["skills/dr/tests/validate-dr.test.ts"]},
    {"inputs": ["skills/implement/references/launch-stops.md", ".ja/skills/implement/references/launch-stops.md"], "tests": ["skills/implement/tests/launch-stops-contract.test.ts"]},
    {"inputs": ["skills/implement/SKILL.md", ".ja/skills/implement/SKILL.md", "skills/implement/references/launch-stops.md", ".ja/skills/implement/references/launch-stops.md", "skills/implement/references/publish.md", ".ja/skills/implement/references/publish.md", "skills/implement/references/capture.md", ".ja/skills/implement/references/capture.md", "skills/implement/scripts/launch.ts"], "tests": ["skills/implement/tests/skill-contract.test.ts"]},
    {"inputs": ["skills/implement/SKILL.md", "skills/scoping/SKILL.md", ".ja/skills/scoping/SKILL.md", "skills/scoping/references/sufficiency.md", ".ja/skills/scoping/references/sufficiency.md", "skills/scoping/references/verification.md", ".ja/skills/scoping/references/verification.md", "skills/scoping/references/issue.md", ".ja/skills/scoping/references/issue.md", "skills/scoping/scripts/find-prior-research.ts", ".ja/skills/scoping/scripts/find-prior-research.ts", "skills/implement/scripts/launch.ts", ".ja/skills/implement/scripts/launch.ts"], "tests": ["skills/implement/tests/workflow-contract.test.js"]},
    {"inputs": ["skills/implement/harness/scripts/**"], "tests": ["skills/implement/tests/capture-adapter.test.ts", "skills/implement/tests/launch-capture.test.ts"]},
    {"inputs": ["skills/outcome/templates/outcome.md", ".ja/skills/outcome/templates/outcome.md", "skills/outcome/SKILL.md", ".ja/skills/outcome/SKILL.md", "rules/core/OUTCOME.md", ".ja/rules/core/OUTCOME.md"], "tests": ["skills/outcome/tests/template-alignment.test.js"]},
    {"inputs": ["skills/outcome/templates/outcome.md", "skills/outcome/tests/fixtures/validate-outcome-cases.json"], "tests": ["skills/outcome/tests/validate-outcome.test.ts"]},
    {"inputs": ["skills/scoping/tests/fixtures/find-prior-research-cases.json"], "tests": ["skills/scoping/tests/find-prior-research.test.ts"]},
    {"inputs": [".gitignore"], "tests": ["skills/scoping/tests/research-tracking.test.ts"]},
    {"inputs": ["settings.json", "rules/development/TOOLS.md", ".ja/rules/development/TOOLS.md"], "tests": ["tests/ast-grep-wiring.test.ts"]},
    {"inputs": ["biome.json"], "tests": ["tests/biome-cognitive-complexity-discipline.test.js"]},
    {"inputs": [".oxlintrc.json"], "tests": ["tests/oxlint-runtime-discipline.test.js"]},
    {"inputs": [".claude-plugin/marketplace.json", "skills/*/SKILL.md", "agents/*/*.md", "README.md", ".ja/README.md"], "tests": ["tests/plugin-manifest.test.ts"]},
    {"inputs": [".github/workflows/test.yml", "docs/SPEC.md"], "tests": ["tests/spec-commands.test.ts"]},
    {"inputs": ["tests/fixtures/tsconfig-scope-fixture.ts"], "tests": ["tests/tsconfig-scope.test.js"]},
    {"inputs": ["hooks/_lib/tests/fixtures/command-scan-tokens.json"], "tests": ["hooks/_lib/tests/command-scan-tokens.test.ts"]},
    {"inputs": ["hooks/_lib/tests/fixtures/hook-payloads.json"], "tests": ["hooks/_lib/tests/hook-payload.test.ts"]},
    {"inputs": ["hooks/_lib/tests/fixtures/harness/**"], "tests": ["hooks/_lib/tests/hook-harness.test.ts"]},
    {"inputs": ["hooks/_lib/tests/fixtures/shebang/**"], "tests": ["hooks/_lib/tests/shebang-scope.test.ts"]},
    {"inputs": ["settings.json"], "tests": ["hooks/_lib/tests/settings-hooks.test.ts"]},
    {"inputs": [".textlintrc.json"], "tests": ["hooks/_lib/tests/textlint.test.ts", "hooks/edit/tests/textlint-fix.test.ts", "hooks/pre-bash/tests/body-proofread-target.test.ts", "hooks/pre-bash/tests/body-proofread-notify.test.ts"]},
    {"inputs": ["hooks/pre-bash/body_proofread.md"], "tests": ["hooks/pre-bash/tests/body-proofread-notify.test.ts", "hooks/pre-bash/tests/body-proofread-target.test.ts"]},
    {"inputs": ["hooks/pre-bash/client_identifier_gate.ts", "hooks/_lib/hook_payload.ts"], "tests": ["hooks/pre-bash/tests/client-identifier-gate.test.ts"]},
    {"inputs": ["hooks/pre-bash/package_manager_rewrite.ts", "hooks/security/npm_install_guard.ts"], "tests": ["hooks/pre-bash/tests/package-manager-rewrite.test.ts"]}
  ]
}
