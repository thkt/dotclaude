{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    // A .ts test importing a .ts helper is the only specifier Node resolves under type
    // stripping, and tsc rejects it without this. Without both, a pure helper is reachable
    // only by spawning the CLI.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "hooks/**/*.ts",
    "skills/**/*.ts",
    "workflows/**/*.ts",
    "tests/**/*.ts",
    "agents/**/*.ts",
    "mods/**/*.ts"
  ],
  // exclude はここが正本ではなく .oxlintrc.json の ignorePatterns 内
  // "skills/*/test/cases/**" の写し。正本を編集したらここも合わせて直す。
  // mods/*/hooks/register.ts と mods/*/tests/ は 'claude-code' の型を import する。その宣言は
  // /plugin-types が各マシンの .claude/types/ に書き出すもので、CI には無い。
  "exclude": ["skills/*/test/cases/**", "mods/*/hooks/register.ts", "mods/*/tests/**"]
}
